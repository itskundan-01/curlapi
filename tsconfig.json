{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "types": ["node"],
    // Mirrors the alias in vite.config.ts, so the UI can reach the server's
    // shared types without counting directories back up to the repository root.
    "baseUrl": ".",
    "paths": { "@core/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "ui/**/*.ts", "ui/**/*.tsx"]
}
