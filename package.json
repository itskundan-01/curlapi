{
  "name": "curlapi",
  "version": "0.2.0-beta.4",
  "description": "A local workspace of API utilities: capture a browser session's real API calls as working curl commands, or turn a handed-over API document into runnable requests.",
  "keywords": [
    "curl",
    "api",
    "devtools",
    "cdp",
    "chrome",
    "har",
    "reverse-engineering",
    "postman",
    "openapi",
    "docx",
    "api-documentation",
    "http",
    "network-capture"
  ],
  "homepage": "https://github.com/itskundan-01/curlapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itskundan-01/curlapi.git"
  },
  "bugs": {
    "url": "https://github.com/itskundan-01/curlapi/issues"
  },
  "license": "MIT",
  "author": "Kundan",
  "type": "module",
  "bin": {
    "curlapi": "./bin/curlapi.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts start",
    "build:ui": "vite build",
    "build:icons": "node scripts/make-icons.mjs",
    "dev:ui": "vite",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build:icons && npm run build:ui"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "files": [
    "bin",
    "src",
    "ui/dist",
    "assets",
    "scripts/make-icons.mjs",
    "README.md",
    "SOP.md",
    "DESIGN.md",
    "LICENSE"
  ]
}
